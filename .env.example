# Copy to .env.local to run `npm run dev` against a live Supabase project.
# Leave everything unset to run the fixture-backed demo (the default).
#
# Both values come from your Supabase project: Settings → API.
# The anon key is safe to expose in the browser — the schema protects data with
# Row-Level Security, not by hiding this key (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force the in-memory demo even when the two values above are set:
# VITE_OFFSITE_MOCK=1
